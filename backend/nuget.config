<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
        <add key="quartz.net" value="https://f.feedz.io/quartznet/quartznet/nuget/index.json"/>
    </packageSources>

    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*"/>
        </packageSource>
        <packageSource key="quartz.net">
            <package pattern="Quartz"/>
            <package pattern="Quartz.*"/>
        </packageSource>
    </packageSourceMapping>
</configuration>