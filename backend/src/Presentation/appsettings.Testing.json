{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Serilog": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppConfig": {
    "Environment": "Local",
    "Version": "1.0.0",
    "ObservabilityConfig": {
      "OtelCollectorEndpoint": "http://localhost:4317",
      "OutputLogsToOtel": false,
      "OutputLogsToConsole": true
    },
    "BackgroundServiceConfig": {
      "OutboxEnabled": true,
      "OutboxIntervalInMs": 1000,
      "OutboxMaxAttempts": 15
    },
    "PaymentConfig": {
      "CollectionEnabled": false,
      "GraceDays": 3,
      "NoticeIntervalDays": [ 0, 7, 14 ],
      "RestrictionProposalDays": 14,
      "ReceiptNumberPrefix": "REC",
      "ApiKey": null,
      "WebhookSecret": null,
      "WebhookToleranceSeconds": 300
    },
    "IdempotencyConfig": {
      "RetentionHours": 24
    },
    "RuleConfig": {
      "DefaultReviewThreshold": 100
    },
    "DecisionConfig": {
      "DefaultHoldWindowMinutes": 1440,
      "DefaultHoldExpiryVerdict": "Block",
      "HoldExpiryBatchSize": 100
    },
    "RateLimitConfig": {
      "Enabled": false,
      "Distributed": {
        "Enabled": false
      }
    }
  },
  "ConnectionStrings": {
    "TransactionMonitoringDb": "Host=localhost;Port=35434;Username=postgres;Password=postgres;Database=transaction_monitoring;Include Error Detail=true"
  }
}
